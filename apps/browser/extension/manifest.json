{
  "manifest_version": 3,
  "name": "Augmentor Agent Browser",
  "version": "0.2.11",
  "description": "Augmentor browser assistant with DSH and Pi harnesses and a shared prompt library.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "scripting",
    "activeTab",
    "sidePanel",
    "windows",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Augmentor — open side panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
