{
  "name": "augmentor-agent-linux-pi",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "python3 scripts/verify-plasma-shader.py && python3 scripts/sync-design.py && tsc -p tsconfig.json && node scripts/copy-protocol.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/runtime/src/main.js",
    "start:codex": "node dist/codex-runtime/src/main.js",
    "test": "node --test tests/*.test.mjs",
    "test:native": "PYTHONPATH=apps/native QT_QPA_PLATFORM=offscreen python3 -m unittest discover -s tests -v",
    "package": "python3 scripts/package-release.py",
    "postinstall": "node scripts/prepare-ws.mjs",
    "prebuild": "node scripts/prepare-ws.mjs",
    "pretest": "node scripts/prepare-ws.mjs",
    "prestart": "node scripts/prepare-ws.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@tufjs/models": "5.0.0",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "tuf-js": "6.0.0",
    "typebox": "1.3.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@openai/codex": "0.159.2",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
