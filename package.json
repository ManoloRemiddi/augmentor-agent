{
  "name": "augmentor-agent-linux-pi",
  "version": "0.2.10",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "python3 scripts/sync-design.py && tsc -p tsconfig.json && node scripts/copy-protocol.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/runtime/src/main.js",
    "test": "node --test tests/*.test.mjs",
    "test:native": "PYTHONPATH=apps/native QT_QPA_PLATFORM=offscreen python3 -m unittest discover -s tests -v",
    "package": "python3 scripts/package-release.py",
    "postinstall": "node scripts/prepare-ws.mjs",
    "prebuild": "node scripts/prepare-ws.mjs",
    "pretest": "node scripts/prepare-ws.mjs",
    "prestart": "node scripts/prepare-ws.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "fflate": "0.8.3",
    "typebox": "1.3.7",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
