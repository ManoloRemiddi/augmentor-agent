{
  "name": "augmentor-agent-linux-pi",
  "version": "0.2.13",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "python3 scripts/verify-plasma-shader.py && python3 scripts/sync-design.py && tsc -p tsconfig.json && node scripts/copy-protocol.mjs && node scripts/build-dsh-gui.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/runtime/src/main.js",
    "harness": "node scripts/open-harness.mjs",
    "harness:proof": "node scripts/harness-ui-proof.mjs",
    "start:codex": "node dist/codex-runtime/src/main.js",
    "test": "node --test tests/*.test.mjs",
    "test:native": "PYTHONPATH=apps/native QT_QPA_PLATFORM=offscreen python3 -m unittest discover -s tests -v",
    "package": "python3 scripts/package-release.py",
    "postinstall": "node scripts/prepare-ws.mjs",
    "prebuild": "node scripts/prepare-ws.mjs",
    "pretest": "node scripts/prepare-ws.mjs",
    "prestart": "node scripts/prepare-ws.mjs"
  },
  "dependencies": {
    "@deepseek-ai/libreoffice-kit": "0.1.5",
    "@deepseek-ai/schemastery": "3.18.3",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-mcp": "1.1.0",
    "fflate": "0.8.3",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "sharp": "0.35.5",
    "typebox": "1.3.7",
    "undici": "8.10.2",
    "ws": "8.21.3",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@openai/codex": "0.159.2",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/harness"
  ]
}
