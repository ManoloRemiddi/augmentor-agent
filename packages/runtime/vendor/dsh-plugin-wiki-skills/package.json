{
  "name": "dsh-plugin-wiki-skills",
  "version": "0.2.1",
  "description": "The claude-obsidian-derived knowledge-suite skills (wiki, wiki-ingest, wiki-query, wiki-lint, save) as a DeepSeek Harness plugin, with attribution.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills/",
    "ORIGINAL_LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "obsidian",
    "knowledge-base",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lion-1209/dsh-plugin-wiki-skills.git"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
