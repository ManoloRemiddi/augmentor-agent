#!/usr/bin/env bash
# Augmentor Linux — native desktop companion
# Copyright © 2026 Manolo Remiddi
# SPDX-License-Identifier: LicenseRef-Augmentor-MIT-Resale-1.0
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$project_dir/apps/native${PYTHONPATH:+:$PYTHONPATH}"
augmentor_python="${AUGMENTOR_PYTHON:-/usr/bin/python3}"
# KWin honors the X11 keep-above request through XWayland. Native Wayland
# keep-above is compositor-specific; retain an explicit platform override.
if [[ -z "${QT_QPA_PLATFORM:-}" && "${XDG_SESSION_TYPE:-}" == wayland && -n "${DISPLAY:-}" ]]; then
  export QT_QPA_PLATFORM=xcb
fi
# Controller starts and reconnects to the runtime on a worker thread.
# Show the window even when cold engine startup is slow or unavailable.
exec "$augmentor_python" -m augmentor_linux "$@"
