#!/usr/bin/env bash
# Augmentor Linux — native desktop companion
# Copyright © 2026 Manolo Remiddi
# SPDX-License-Identifier: LicenseRef-Augmentor-MIT-Resale-1.0
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$project_dir/apps/native${PYTHONPATH:+:$PYTHONPATH}"
augmentor_python="${AUGMENTOR_PYTHON:-/usr/bin/python3}"
if [[ -f "$project_dir/scripts/linux-python-runtime.py" || -e "$project_dir/linux-python-runtime.json" || -L "$project_dir/linux-python-runtime.json" ]]; then
  # Leap 16 supplies versioned Python without a /usr/bin/python3 alias.
  # Use a system bootstrap only to verify the declared runtime; never fall
  # through to another interpreter after a policy or inventory refusal.
  augmentor_bootstrap=/usr/bin/python3
  if [[ ! -x "$augmentor_bootstrap" && -x /usr/bin/python3.13 ]]; then
    augmentor_bootstrap=/usr/bin/python3.13
  fi
fi
# KWin honors the X11 keep-above request through XWayland. Native Wayland
# keep-above is compositor-specific; retain an explicit platform override.
if [[ -z "${QT_QPA_PLATFORM:-}" && "${XDG_SESSION_TYPE:-}" == wayland && -n "${DISPLAY:-}" ]]; then
  export QT_QPA_PLATFORM=xcb
fi
# Controller starts and reconnects to the runtime on a worker thread.
# Show the window even when cold engine startup is slow or unavailable.
if [[ -f "$project_dir/scripts/linux-python-runtime.py" || -e "$project_dir/linux-python-runtime.json" || -L "$project_dir/linux-python-runtime.json" ]]; then
  exec "$augmentor_bootstrap" "$project_dir/scripts/linux-python-runtime.py" exec --app-root "$project_dir" --exec-args -m augmentor_linux "$@"
fi
export AUGMENTOR_PYTHON="$augmentor_python"
exec "$augmentor_python" -m augmentor_linux "$@"
