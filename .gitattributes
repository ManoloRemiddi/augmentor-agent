# Source and provenance hashes must not depend on the checkout's operating system.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.qsb -text
*.tgz -text
*.wasm -text
*.png -text
*.jpg -text
*.ico -text
*.icns -text
# Preserve reviewed supplier bytes and checksum-pinned notices on every OS.
components/handy/** -text
# Original supplier notices include whitespace covered by the artifact hashes.
vendor/quickjs-engine/** -text -whitespace
LICENSE -text
