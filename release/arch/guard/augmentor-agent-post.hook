[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = augmentor-agent

[Action]
Description = Verifying the completed Augmentor package and payload...
When = PostTransaction
Exec = /usr/bin/python3 -I /usr/lib/augmentor-package-guard/lifecycle.py complete --target arch20261001-x86_64
Depends = python
