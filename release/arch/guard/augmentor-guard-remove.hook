[Trigger]
Operation = Remove
Type = Package
Target = augmentor-package-guard

[Action]
Description = Checking that Augmentor's guard can be removed...
When = PreTransaction
Exec = /usr/bin/python3 -I /usr/lib/augmentor-package-guard/can-remove.py
Depends = python
AbortOnFail
