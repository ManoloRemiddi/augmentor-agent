[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = augmentor-agent

[Action]
Description = Checking Augmentor leases and recording durable package maintenance...
When = PreTransaction
Exec = /usr/bin/python3 -I /usr/lib/augmentor-package-guard/lifecycle.py begin --target arch20261001-x86_64 --operation alpm
Depends = python
AbortOnFail
